{
  "name": "vaga-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Radar local de oportunidades e preparação de candidaturas",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --use-env-proxy src/server.js",
    "dev": "node --use-env-proxy --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "node scripts/test-ui.js",
    "demo": "node scripts/demo.js",
    "sources:example": "node scripts/configure-sources.js",
    "collect": "node --use-env-proxy scripts/collect.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mailparser": "^3.7.5",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pino": "^10.1.0",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1",
    "supertest": "^7.1.4"
  }
}
